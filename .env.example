# Anthropic API — used by the Convex brainstorm action (server-side only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Convex deployment URL — exposed to the browser via Vite
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deployment ID (used by convex CLI)
CONVEX_DEPLOYMENT=your_deployment_id

# Hercules API Configuration
HERCULES_API_KEY=your_api_key_here

# Supabase Configuration
# Find these in your Supabase project: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
